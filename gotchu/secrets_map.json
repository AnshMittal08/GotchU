{
  "version": 1,
  "about": "Where programs keep secrets on Windows. Data only: add an entry, no code change needed. 'owners' are the programs that are supposed to read the store; 'signer' is the publisher on their code signature (only filled in where it was checked on a real install); 'watch' narrows the tripwire to one file inside a folder.",
  "browsers": [
    {"name": "Google Chrome", "engine": "chromium", "root": "%LOCALAPPDATA%\\Google\\Chrome\\User Data", "owners": ["chrome.exe"], "signer": "Google LLC"},
    {"name": "Microsoft Edge", "engine": "chromium", "root": "%LOCALAPPDATA%\\Microsoft\\Edge\\User Data", "owners": ["msedge.exe"], "signer": "Microsoft Corporation"},
    {"name": "Brave", "engine": "chromium", "root": "%LOCALAPPDATA%\\BraveSoftware\\Brave-Browser\\User Data", "owners": ["brave.exe"]},
    {"name": "Vivaldi", "engine": "chromium", "root": "%LOCALAPPDATA%\\Vivaldi\\User Data", "owners": ["vivaldi.exe"]},
    {"name": "Opera", "engine": "chromium", "root": "%APPDATA%\\Opera Software\\Opera Stable", "owners": ["opera.exe"]},
    {"name": "Opera GX", "engine": "chromium", "root": "%APPDATA%\\Opera Software\\Opera GX Stable", "owners": ["opera.exe"]},
    {"name": "Mozilla Firefox", "engine": "firefox", "root": "%APPDATA%\\Mozilla\\Firefox\\Profiles", "owners": ["firefox.exe"], "signer": "Mozilla Corporation"}
  ],
  "wallet_extensions": {
    "nkbihfbeogaeaoehlefnkodbefgpgknn": "MetaMask",
    "bfnaelmomeimhlpmgjnjophhpkkoljpa": "Phantom",
    "hnfanknocfeofbddgcijnmhnfnkdnaad": "Coinbase Wallet",
    "egjidjbpglichdcondbcbdnbeeppgdph": "Trust Wallet"
  },
  "stores": [
    {"name": "Telegram Desktop", "kind": "messenger", "path": "%APPDATA%\\Telegram Desktop\\tdata", "owners": ["Telegram.exe"], "signer": "Telegram FZ-LLC", "watch": "key_datas"},
    {"name": "Discord", "kind": "messenger", "path": "%APPDATA%\\discord\\Local Storage\\leveldb", "owners": ["Discord.exe"], "signer": "Discord Inc."},
    {"name": "Signal", "kind": "messenger", "path": "%APPDATA%\\Signal\\config.json", "owners": ["Signal.exe"]},

    {"name": "Amazon Web Services keys", "kind": "cloud", "path": "%USERPROFILE%\\.aws\\credentials", "contains": "aws_secret_access_key"},
    {"name": "Google Cloud sign-in", "kind": "cloud", "path": "%APPDATA%\\gcloud\\credentials.db", "rows": "SELECT COUNT(*) FROM credentials"},
    {"name": "Google Cloud application key", "kind": "cloud", "path": "%APPDATA%\\gcloud\\application_default_credentials.json"},
    {"name": "Azure sign-in", "kind": "cloud", "path": "%USERPROFILE%\\.azure\\msal_token_cache.json"},
    {"name": "Kubernetes cluster access", "kind": "cloud", "path": "%USERPROFILE%\\.kube\\config"},
    {"name": "Docker registry login", "kind": "cloud", "path": "%USERPROFILE%\\.docker\\config.json", "contains": "\"auth\":"},
    {"name": "GitHub command-line token", "kind": "cloud", "path": "%APPDATA%\\GitHub CLI\\hosts.yml", "contains": "oauth_token"},
    {"name": "Git saved passwords", "kind": "cloud", "path": "%USERPROFILE%\\.git-credentials"},
    {"name": "npm publish token", "kind": "cloud", "path": "%USERPROFILE%\\.npmrc", "contains": "_authToken"},

    {"name": "Exodus wallet", "kind": "wallet", "path": "%APPDATA%\\Exodus\\exodus.wallet"},
    {"name": "Electrum wallet", "kind": "wallet", "path": "%APPDATA%\\Electrum\\wallets"},
    {"name": "Atomic wallet", "kind": "wallet", "path": "%APPDATA%\\atomic\\Local Storage\\leveldb"}
  ],
  "key_file_folders": [
    "%USERPROFILE%\\.ssh",
    "%USERPROFILE%\\Downloads",
    "%USERPROFILE%\\Desktop",
    "%USERPROFILE%\\Documents"
  ]
}
